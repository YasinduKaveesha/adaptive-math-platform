# Local environment and secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Logs and local runtime files
*.log
*.pid

# Operating-system and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Markdown documentation is local-only except the three approved README files.
*.md
!/README.md
!/backend/README.md
!/frontend/README.md
!/backend/buildLog.md
# buildLog.md was closed at FE-0c and rotated; all later batch entries live here.
!/backend/buildLog1.md
# Carries the mandatory "delete this directory when FE-1b lands" notice for the dev fixture.
!/backend/scripts/README.md
!/backend/packaging/component_b_internal/IMPORT_POLICY.md
# Supervisor BE4 sequencing guidance (tracked documentation, not a README).
!/Component_B_BE4_Sequencing_Plan.md

# BE0 provenance evidence is intentionally version-controlled.
!/backend/provenance/
!/backend/provenance/*.json
!/backend/provenance/*.in
!/backend/provenance/*.lock

# BE3b/BE3c test fixture (not documentation): the *.md rule above would otherwise silently
# exclude this file from every commit, even though BE3b's and BE3c's test suites depend on it.
!/backend/tests/fixtures/runtime_bundle/test_catalogue.md
!/Component_B_Backend_Overview.md
!/Component_B_Measurement_And_Parity_Review.md
!/Component_B_Backend_Work_Order.md
