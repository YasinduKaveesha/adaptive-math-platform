# Safe local-development placeholders only. Copy to .env and replace locally.
APP_ENV=development
BACKEND_CODE_VERSION=0.1.0-be1.1
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
POSTGRES_DB=upadya
POSTGRES_USER=upadya
POSTGRES_PASSWORD=replace-with-a-local-secret
DATABASE_URL=postgresql://upadya:replace-with-a-local-secret@db:5432/upadya
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_CACHE_TTL_SECONDS=300
